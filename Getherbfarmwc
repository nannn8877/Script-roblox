    for i = 1, 3 do
        print("🎰 รอบที่ " .. i)

        -- สุ่มวงล้อ
        spinRemote:FireServer()
        task.wait(0.8) -- รอ animation / server

        -- skip
        skipRemote:FireServer(vec, 5)
