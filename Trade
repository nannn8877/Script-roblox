  }

  -- ถ้ามีไฟล์ elixir_uuids.txt → โหลดเพิ่ม (from uuid_log.lua)
  local extraFile = "elixir_uuids.txt"
  if isfile and isfile(extraFile) then
    local content = readFileSafe(extraFile)
    local seen = {}
    for _, u in ipairs(UUID_BANK) do seen[u] = true end
    for line in content:gmatch("[^\r\n]+") do
      line = line:gsub("%s+", "")
      if #line == 36 and not seen[line] then
        table.insert(UUID_BANK, line)
        seen[line] = true
      end
    end
  end

  logLine(("  → fire R_ADD × %d UUIDs (slow mode)"):format(#UUID_BANK))
  local fired = 0
