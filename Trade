-- ============================================================
-- trade.lua — Auto-trade dispatcher (autoexec)
-- ============================================================
-- Role detection:
--   if LocalPlayer.Name == receiver_name.txt → run RECEIVER loop
--   if trade_start.txt == "1"                 → run SENDER once
--   else                                      → exit (ปกติ farm)
-- 
-- ไฟล์ในแต่ละ Codex workspace (per-pkg):
--   INPUT (bash writes):
--     receiver_name.txt  = ชื่อ A acc
--     trade_target.txt   = ชื่อ A (for sender)
--     trade_start.txt    = "1" = trigger sender
--   OUTPUT (lua writes):
--     receiver_ready.txt = timestamp (A ready)
--     trade_done.txt     = "ok:username"
--     trade_fail.txt     = "reason"
--     trade_empty.txt    = "no elixir"
--     trade_no_target.txt
--     trade_timeout.txt
--     trade_log.txt      = log of events
-- ============================================================

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

-- ⏳ Wait for LocalPlayer (autoexec อาจรันก่อน LP โหลด)
local LP = Players.LocalPlayer
if not LP then
  repeat task.wait(0.1) until Players.LocalPlayer
  LP = Players.LocalPlayer
end

-- Wait for character (กัน LP.Name nil)
if not LP.Character then
  LP.CharacterAdded:Wait()
end

local MY_NAME = LP.Name

-- ═══ Config ═══
local TRADE_TIMEOUT = 120       -- overall sender timeout
local ADD_CLICK_COUNT = 60      -- click N times with jitter (Test G pattern)
local ADD_CLICK_DELAY = 0.2     -- (used as base, real delay = 0.1-0.25 jittered)
local RECEIVER_HEARTBEAT = 10   -- receiver write ready.txt every N sec

-- ═══ Bytes (UTF-8 chinese strings) ═══
local B_TRADE   = "\228\186\164\230\152\147"        -- 交易
local B_ELIXIR  = "\228\184\185\232\141\175"        -- 丹药
local B_MY_BAG  = "\230\136\145\231\154\132\232\131\140\229\140\133"  -- 我的背包
local B_LABELS  = "\230\160\135\231\173\190"        -- 标签
local B_UI_POPUP = "\230\137\147\229\188\128\229\188\185\229\135\186\230\161\134"  -- 打开弹出框
local B_UI_INVITE = "\230\137\147\229\188\128\229\128\146\232\174\161\230\151\182\230\161\134"  -- 打开倒计时框
local B_PLAYER_LIST = "\228\186\164\230\152\147\231\142\169\229\174\182\229\136\151\232\161\168"  -- 交易玩家列表
local B_PLAYER_ITEMS = "\231\142\169\229\174\182\228\186\164\230\152\147\231\137\169\229\147\129\230\149\176\230\141\174"  -- 玩家交易物品数据
local B_LOCK_DICT = "\231\142\169\229\174\182\233\148\129\229\174\154\229\173\151\229\133\184"  -- 玩家锁定字典

-- ═══ Helpers ═══
local function readFileSafe(path)
  if not isfile or not isfile(path) then return "" end
  local ok, data = pcall(readfile, path)
  return (ok and data) or ""
end

local function writeFileSafe(path, content)
  if writefile then pcall(writefile, path, tostring(content or "")) end
end

local _logBuffer = {}
local function logLine(msg)
  local stamp = "??:??:??"
  pcall(function() stamp = os.date("%H:%M:%S") end)
  local line = ("[%s] %s"):format(stamp, msg)
  pcall(function() print("[TRADE] " .. msg) end)
  table.insert(_logBuffer, line)
  -- เขียนทุกครั้ง — ไม่ append เพื่อกัน race
  pcall(function()
    if writefile then
      writefile("trade_log.txt", table.concat(_logBuffer, "\n"))
    end
  end)
end

-- เขียน "BOOT" ทันทีตอน script เริ่ม → ถ้าเห็นบรรทัดนี้ใน trade_log = script รันแน่นอน
logLine("══════ TRADE.LUA BOOT ══════")
logLine("MY_NAME = " .. tostring(MY_NAME))

-- ═══ Check role FIRST (ก่อน resolve remote ใดๆ) ═══
local receiverName = readFileSafe("receiver_name.txt"):gsub("%s+", "")
local tradeStart = readFileSafe("trade_start.txt"):gsub("%s+", "")

logLine(("Init: me=%s, receiver=%s, trade_start=%s"):format(MY_NAME, receiverName, tradeStart))

-- ⚡ Early exit ถ้าไม่ใช่ trade role — ไม่ต้องเสียเวลา resolve remote
if MY_NAME ~= receiverName and tradeStart ~= "1" then
  logLine("(farm mode — trade script idle, exit)")
  return
end

-- ═══ Resolve remotes (เฉพาะกรณี role = trade) ═══
local function getRemote(folder, name)
  local ok, result = pcall(function()
    local node = RS
    for part in folder:gmatch("[^.]+") do
      node = node:WaitForChild(part, 5)
      if not node then return nil end
    end
    return node:WaitForChild(name, 5)
  end)
  return ok and result or nil
end

local BASE = "\228\186\139\228\187\182.\229\133\172\231\148\168"  -- 事件.公用
local R_REQUEST = getRemote(BASE .. "." .. B_TRADE, "\231\148\179\232\175\183\228\186\164\230\152\147")  -- 申请交易
local R_LOCK    = getRemote(BASE .. "." .. B_TRADE, "\233\148\129\229\174\154\228\186\164\230\152\147")  -- 锁定交易
local R_CANCEL  = getRemote(BASE .. "." .. B_TRADE, "\229\143\150\230\182\136\228\186\164\230\152\147")  -- 取消交易
local R_SYNC    = getRemote(BASE .. "." .. B_TRADE, "\228\186\164\230\152\147\230\149\176\230\141\174\229\144\140\230\173\165")  -- 交易数据同步
local R_ADD     = getRemote(BASE .. "." .. B_TRADE, "\230\150\176\229\162\158\228\186\164\230\152\147\231\137\169\229\147\129")  -- 新增交易物品
local R_POPUP   = getRemote(BASE .. ".UI", B_UI_POPUP)
local R_INVITE  = getRemote(BASE .. ".UI", B_UI_INVITE)
local R_SYNC_ELX = getRemote(BASE .. "." .. B_ELIXIR, "\229\144\140\230\173\165\228\184\185\232\141\175\230\149\176\230\141\174")  -- 同步丹药数据

logLine(("Remotes: req=%s lock=%s sync=%s add=%s popup=%s invite=%s elxsync=%s"):format(
  tostring(R_REQUEST ~= nil), tostring(R_LOCK ~= nil),
  tostring(R_SYNC ~= nil), tostring(R_ADD ~= nil),
  tostring(R_POPUP ~= nil), tostring(R_INVITE ~= nil),
  tostring(R_SYNC_ELX ~= nil)))

-- ⚡ Elixir inventory cache — listen ตั้งแต่ early เพื่อจับ initial sync
local _ELIXIR_INV = {}  -- {uuid = count}
if R_SYNC_ELX then
  R_SYNC_ELX.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end
    -- log จำนวน item เพื่อ debug
    local n = 0
    for _, item in pairs(data) do
      if type(item) == "table" then
        local uuid = item["\231\180\162\229\188\149"]  -- 索引
        local count = item["\230\149\176\233\135\143"]  -- 数量
        if uuid then
          _ELIXIR_INV[uuid] = count or 1
          n = n + 1
        end
      end
    end
    logLine(("← R_SYNC_ELX: %d items (cache=%d)"):format(n,
      (function() local c=0; for _ in pairs(_ELIXIR_INV) do c=c+1 end; return c end)()))
  end)
end

-- Verify remotes
if not R_REQUEST or not R_LOCK or not R_ADD then
  logLine("❌ Missing trade remotes — abort")
  writeFileSafe("trade_fail.txt", "remotes not found")
  return
end

-- ============================================================
-- RECEIVER (A)
-- ============================================================
local function runReceiver()
  logLine("★ RECEIVER mode — " .. MY_NAME)
  writeFileSafe("receiver_ready.txt", tostring(os.time()))

  local STATE = "IDLE"
  local stateStart = tick()
  local currentPartner = nil
  local myUserId = tostring(LP.UserId)

  -- heartbeat loop
  task.spawn(function()
    while true do
      task.wait(RECEIVER_HEARTBEAT)
      writeFileSafe("receiver_ready.txt", tostring(os.time()))
    end
  end)

  -- === Listen invite popup (打开倒计时框) ===
  -- Fire ทันทีที่มี trade invite — ก่อน sync จะตอบกลับ
  if R_INVITE then
    R_INVITE.OnClientEvent:Connect(function(msg, fromPlayer)
      logLine(("← INVITE popup: msg=%s from=%s"):format(tostring(msg), tostring(fromPlayer)))
      if STATE == "IDLE" then
        -- extract sender name from message: "<NAME> has invited you to trade"
        if type(msg) == "string" then
          local senderName = msg:match("^(.+) has invited") or msg:match("^(%S+)")
          currentPartner = senderName
        end
        STATE = "ACCEPTING"
        stateStart = tick()
      end
    end)
  end

  -- === Listen trade sync (R_SYNC) ===
  R_SYNC.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end

    local playerList = data[B_PLAYER_LIST]
    if type(playerList) ~= "table" then return end

    -- Find partner (not me)
    local partner = nil
    local partnerId = nil
    for _, name in pairs(playerList) do
      if name ~= MY_NAME then partner = name end
    end

    -- Find partner userId from items
    local itemsData = data[B_PLAYER_ITEMS] or {}
    for uid, _ in pairs(itemsData) do
      if tostring(uid) ~= myUserId then partnerId = tostring(uid) end
    end

    -- Backup trigger: ถ้ายัง IDLE แต่ sync มาแสดงว่ามี trade เริ่ม
    if STATE == "IDLE" and partner then
      currentPartner = partner
      STATE = "ACCEPTING"
      stateStart = tick()
      logLine("← trade detected via sync: " .. partner)
    end

    -- check B locked
    local lockDict = data[B_LOCK_DICT] or {}
    if STATE == "WAIT_B_LOCK" and partnerId and lockDict[partnerId] == true then
      STATE = "SELF_LOCK"
      logLine("  B locked → self lock")
    end
  end)

  -- === Listen R_REQUEST (申请交易) — server fire ตรงนี้ตอน trade เริ่ม ===
  -- จาก find_sync.txt: arg1=sender_name, arg2=table (trade data)
  R_REQUEST.OnClientEvent:Connect(function(arg1, arg2)
    logLine(("← R_REQUEST event: arg1=%s arg2type=%s"):format(
      tostring(arg1), type(arg2)))

    -- arg1 = sender name → invite!
    if STATE == "IDLE" and type(arg1) == "string" and arg1 ~= MY_NAME then
      currentPartner = arg1
      STATE = "ACCEPTING"
      stateStart = tick()
      logLine("← trade invite via R_REQUEST: " .. arg1)
    end

    -- arg2 = table (trade data) — check lock state
    if type(arg2) == "table" then
      local lockDict = arg2[B_LOCK_DICT] or {}
      for uid, v in pairs(lockDict) do
        if tostring(uid) ~= myUserId and v == true then
          if STATE == "WAIT_B_LOCK" then
            STATE = "SELF_LOCK"
            logLine("  B locked (via R_REQUEST) → self lock")
          end
        end
      end
    end
  end)

  -- === Listen popup (complete/cancel + invite) ===
  R_POPUP.OnClientEvent:Connect(function(arg1, arg2)
    -- popup arg = (icon, message) or (message, ?)
    local msg = ""
    if type(arg2) == "string" then msg = arg2
    elseif type(arg1) == "string" then msg = arg1 end
    if msg == "" then return end

    if msg:find("Successful") or msg:find("成功") then
      logLine("✓ trade success with " .. (currentPartner or "?"))
      STATE = "IDLE"
      currentPartner = nil
    elseif msg:find("Cancel") or msg:find("取消") then
      logLine("✗ trade cancelled")
      STATE = "IDLE"
      currentPartner = nil
    elseif STATE == "IDLE" and (msg:find("invited") or msg:find("邀请") or msg:find("trade")) then
      -- invite popup ทั่วไป (ไม่ใช่ countdown)
      logLine("← INVITE popup (generic): " .. msg:sub(1, 60))
      STATE = "ACCEPTING"
      stateStart = tick()
    end
  end)

  -- === AGGRESSIVE: spam fire 申请交易 ว่าง ทุก 2s — accept pending invite ===
  -- ถ้า server ไม่มี pending → noop / ignored
  -- ถ้ามี pending invite → server เปิด trade window
  task.spawn(function()
    while true do
      task.wait(2)
      if STATE == "IDLE" then
        pcall(function() R_REQUEST:FireServer() end)
      end
    end
  end)

  -- === Main loop ===
  while true do
    task.wait(0.5)

    if STATE == "ACCEPTING" then
      task.wait(0.5)
      pcall(function() R_REQUEST:FireServer() end)  -- empty fire = accept
      STATE = "WAIT_B_LOCK"
      stateStart = tick()
      logLine("  → accepted (FireServer 申请交易 empty)")
    elseif STATE == "SELF_LOCK" then
      pcall(function() R_LOCK:FireServer(true) end)
      STATE = "WAIT_COMPLETE"
      stateStart = tick()
      logLine("  → self locked")
    elseif STATE == "WAIT_B_LOCK" then
      if tick() - stateStart > 60 then
        logLine("⏱ timeout waiting B lock → cancel")
        pcall(function() R_CANCEL:FireServer() end)
        STATE = "IDLE"
        currentPartner = nil
      end
    elseif STATE == "WAIT_COMPLETE" then
      if tick() - stateStart > 30 then
        logLine("⏱ timeout waiting complete")
        STATE = "IDLE"
        currentPartner = nil
      end
    end
  end
end

-- ============================================================
-- SENDER (B)
-- ============================================================
local function runSender()
  local target = readFileSafe("trade_target.txt"):gsub("%s+", "")
  logLine("★ SENDER mode — " .. MY_NAME .. " → " .. target)

  if target == "" then
    logLine("❌ empty target")
    writeFileSafe("trade_fail.txt", "empty target")
    return
  end

  -- clear start flag so won't re-run on reconnect
  writeFileSafe("trade_start.txt", "0")

  -- ⏳ Wait extra time for game scripts/PlayerGui to fully initialize
  -- (autoexec รันก่อน game scripts บางตัว — ต้องรอนาน)
  logLine("  ⏳ wait 15s for game fully load...")
  task.wait(15)
  logLine("  ✓ ready to start sender flow")

  local myUserId = tostring(LP.UserId)

  -- ═══ [1] Wait for target in Players ═══
  logLine("[1] Wait for target...")
  local targetPlayer = nil
  local deadline = tick() + 30
  while tick() < deadline do
    targetPlayer = Players:FindFirstChild(target)
    if targetPlayer then break end
    task.wait(1)
  end
  if not targetPlayer then
    logLine("❌ target not in server: " .. target)
    writeFileSafe("trade_no_target.txt", target)
    return
  end
  logLine("  ✓ found " .. target)

  -- ═══ [2] Request trade (ไม่ rely on sync) ═══
  logLine("[2] Request trade")
  local completed = false
  local completeMsg = nil

  -- Listen popup เท่านั้น (success/cancel)
  local connPopup = R_POPUP.OnClientEvent:Connect(function(arg1, arg2)
    local msg = ""
    if type(arg2) == "string" then msg = arg2
    elseif type(arg1) == "string" then msg = arg1 end
    if msg == "" then return end

    if msg:find("Successful") or msg:find("成功") then
      completed = true; completeMsg = "done"
    elseif msg:find("Cancel") or msg:find("取消") then
      completed = true; completeMsg = "cancelled"
    end
  end)

  pcall(function() R_REQUEST:FireServer(targetPlayer) end)
  logLine("  fired 申请交易(target)")

  -- รอ A accept (fixed 8s — A spam empty fire ทุก 2s)
  task.wait(8)
  logLine("  → assume trade opened")

  -- ═══ [3] Direct fire R_ADD per UUID — ไม่ผ่าน UI click! ═══
  logLine("[3] Add elixirs DIRECTLY via R_ADD per UUID")

  -- Click tab elixir 1 ครั้ง — trigger UI render (เผื่อ server push update)
  local gui = LP:WaitForChild("PlayerGui", 10)
  if gui then
    task.wait(2)
    for _, desc in pairs(gui:GetDescendants()) do
      if (desc:IsA("TextButton") or desc:IsA("ImageButton")) and desc.Name == B_ELIXIR then
        local full = desc:GetFullName()
        if full:find(B_TRADE, 1, true) and full:find(B_MY_BAG, 1, true) then
          pcall(function() firesignal(desc.Activated) end)
          logLine("  → click tab elixir (trigger UI)")
          break
        end
      end
    end
  end

  -- รอ inventory cache ค่อยๆ update
  logLine("  ⏳ wait 3s for inventory data...")
  task.wait(3)

  -- Snapshot UUIDs
  local uuidList = {}
  for uuid, _ in pairs(_ELIXIR_INV) do
    table.insert(uuidList, uuid)
  end
  logLine(("  inventory cache: %d unique elixirs"):format(#uuidList))

  if #uuidList == 0 then
    logLine("  ⊘ no elixirs in inventory cache — skip add (will lock empty)")
  else
    -- Fire R_ADD per UUID — server validate + add
    logLine(("  → fire R_ADD × %d UUIDs"):format(#uuidList))
    local fired = 0
    for i, uuid in ipairs(uuidList) do
      local ok = pcall(function()
        R_ADD:FireServer(B_ELIXIR, uuid, 9999999999)
      end)
      if ok then fired = fired + 1 end
      logLine(("    [%d/%d] uuid=%s ok=%s"):format(i, #uuidList, uuid:sub(1, 8), tostring(ok)))
      task.wait(0.15)  -- ห่างเล็กน้อย กัน rate limit
    end
    logLine(("  ✓ fired %d/%d R_ADD"):format(fired, #uuidList))
  end

  task.wait(2)

  -- ═══ [4] Lock ═══
  logLine("[4] Lock")
  pcall(function() R_LOCK:FireServer(true) end)

  -- ═══ [5] Wait popup completion (NO aLocked check) ═══
  logLine("[5] Wait completion popup (60s)")
  local t3 = tick()
  while tick() - t3 < 60 do
    if completed then break end
    task.wait(0.5)
  end

  connPopup:Disconnect()

  if completeMsg == "done" then
    logLine("✓ TRADE SUCCESS")
    writeFileSafe("trade_done.txt", MY_NAME .. ":" .. target)
  elseif completeMsg == "cancelled" then
    logLine("✗ TRADE CANCELLED")
    writeFileSafe("trade_fail.txt", "cancelled")
  else
    logLine("⏱ no popup in 60s — assume done")
    writeFileSafe("trade_done.txt", MY_NAME .. ":" .. target .. ":noPopup")
  end
end

-- ============================================================
-- DISPATCH
-- ============================================================
if MY_NAME == receiverName and receiverName ~= "" then
  runReceiver()
elseif tradeStart == "1" then
  runSender()
else
  logLine("(farm mode — trade script idle)")
end
