-- 6. Event เมื่อคลิกปุ่ม
button.MouseButton1Click:Connect(function()
    -- ส่ง RemoteEvent Herb
    local numbers = {1,2,3,4,5}
    local vec = Vector2.new(654.7196655273438, 178.2879180908203)
    for _, num in ipairs(numbers) do
        herbRemote:FireServer(num, vec)
    end

    -- ส่ง RemoteEvent Mailbox
    mailboxRemote:FireServer()
end)
