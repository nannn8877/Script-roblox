-- bytes ของ 名称
local NAME_LABEL = "\229\144\141\231\167\176"

-- =========================
-- ฟังก์ชันซื้อสมุนไพรทุกช่องที่เจอ
-- ใช้ลำดับจาก GetChildren() ตรงๆ (LayoutOrder = 0 ทุกช่อง)
-- เช็คเฉพาะ 名称.Text == "Herb" เท่านั้น
-- =========================

local function autoBuyHerb()
    for _, obj in pairs(playerGui:GetDescendants()) do
        if obj.Name == "\229\136\151\232\161\168"              -- 列表
            and obj.Parent
            and obj.Parent.Name == "\229\149\134\229\186\151"  -- 商店
        then
            local found = false
            local index = 0

            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Frame") then
                    index = index + 1

                    -- หา 名称 label ใน Frame นี้
                    local nameLabel = child:FindFirstChild(NAME_LABEL, true)  -- recursive
                    if nameLabel and nameLabel.Text == "Herb" then
                        print("✅ ช่อง " .. index .. " = Herb → ซื้อ")
                        buyRemote:FireServer(index)
                        task.wait(0.15)
                        found = true
                    end
                end
            end

            if not found then
                print("ℹ️ ไม่พบสมุนไพรในร้านวันนี้")
            end
            return
        end
    end
    print("❌ หา 列表 ไม่เจอ")
end

