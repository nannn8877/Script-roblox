-- =========================
-- Elixir Producer
-- =========================

local function startElixirProducer()
    task.spawn(function()
        print("⚗️ Elixir Producer started — " .. FILE_STATS)
        while true do
            local content = safeRead(FILE_STATS)

            if content and content:lower():find("on") then
                local eok, eerr = pcall(function()
                    elixirRemote:FireServer()
                end)
                if not eok then
                    print("❌ Elixir Error: " .. tostring(eerr))
                end
                writeBase()
            else
                print("⏸️ Elixir paused (stats != on)")
            end

            task.wait(1)
        end
    end)
end

