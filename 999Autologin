            if num then return num end
        end
    end
    return nil
end

-- =========================
-- File helpers
-- =========================

local function safeRead(filename)
    local ok, content = pcall(function() return readfile(filename) end)
    if ok and content then return content end
    return nil
end

local function safeWrite(filename, content)
    pcall(function() writefile(filename, content) end)
end

-- =========================
-- Date / Username
-- =========================

local function getToday()
    local ok, result = pcall(function() return os.date("%Y-%m-%d") end)
    if ok and result then return result end
    return tostring(os.time())
end

local function getUsername()
    return USERNAME
end

-- =========================
-- Herb count → number
-- =========================

local function parseHerb(raw)
    if not raw or raw == "N/A" then return nil end
    local s = tostring(raw):gsub(",", ""):gsub(" ", "")
    local kVal = s:match("^(%d+%.?%d*)[Kk]$")
    if kVal then return math.floor(tonumber(kVal) * 1000) end
    return tonumber(s)
end

-- =========================
-- Write base.txt (herb count)
-- =========================

local function writeBase()
    local herb = getHerbCount()
    local num = parseHerb(herb)
    local val = num and tostring(num) or tostring(herb)
    safeWrite(FILE_BASE, val)
    print("📦 " .. FILE_BASE .. ": " .. val)
end

-- =========================
-- daily.txt
-- =========================

local function isDailyDone()
    local content = safeRead(FILE_DAILY)
    if not content then return false end
    local today = getToday()
    if content:find(today, 1, true) then
        print("✅ Daily already done today (" .. today .. ") — skip")
        return true
    end
    return false
end

local function writeDailyFile()
    local content = getUsername() .. "|" .. getToday()
    safeWrite(FILE_DAILY, content)
    print("📅 " .. FILE_DAILY .. ": " .. content)
end

-- =========================
-- login_trigger.txt → trigger.txt
-- =========================

local function isLoginTriggered()
    local content = safeRead(FILE_TRIGGER)
    if not content then return false end
    return content:lower():find("on") ~= nil
end

local function waitForLoginTrigger()
    print("⏳ Waiting for trigger: " .. FILE_TRIGGER)
    while true do
        if isLoginTriggered() then
            print("✅ Login trigger received")
            return
        end
        task.wait(3)
    end
end

-- =========================
-- Guild shop — ซื้อสมุนไพร
-- =========================

local function autoBuyHerb()
    for _, obj in pairs(playerGui:GetDescendants()) do
        if obj.Name == "\229\136\151\232\161\168"
            and obj.Parent
            and obj.Parent.Name == "\229\149\134\229\186\151"
        then
            local index = 0
            local found = false
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Frame") then
                    index = index + 1
                    local nameLabel = child:FindFirstChild("\229\144\141\231\167\176", true)
                    if nameLabel and nameLabel.Text == "Herb" then
                        local coins = getGuildCoins()
                        if coins and coins >= 400 then
                            print("✅ Slot " .. index .. " = Herb | coins=" .. coins .. " → buy")
                            buyRemote:FireServer(index)
                            task.wait(0.2)
                            found = true
                        else
                            print("⛔ Not enough coins (" .. tostring(coins) .. ")")
                        end
                    end
                end
            end
            if not found then print("ℹ️ Herb not found in shop") end
            return
        end
    end
    print("❌ Shop list not found")
end

local function buyHerbWithRefresh()
    autoBuyHerb()
    task.wait(0.3)
    local coinsLeft = getGuildCoins()
    if coinsLeft and coinsLeft >= 400 then
        print("🔄 Refreshing shop")
        refreshRemote:FireServer()
        task.wait(1.5)
        autoBuyHerb()
    else
        print("ℹ️ Not enough coins to refresh")
    end
end

