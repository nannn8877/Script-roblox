local function getHerbCount()
    local gui = playerGui:FindFirstChild("GUI")
    if not gui then return "N/A" end
    local obj = gui
    local path = {
        "\228\184\187\231\149\140\233\157\162",
        "\228\184\187\229\159\142",
        "\232\180\167\229\184\129\229\140\186\229\159\159",
        "\232\141\137\232\141\175",
        "\230\140\137\233\146\174",
        "\229\128\188"
    }
    for _, name in ipairs(path) do
        obj = obj:FindFirstChild(name)
        if not obj then return "N/A" end
    end
    return tostring(obj.Text or "N/A")
end

local function getGuildCoins()
    local gui = playerGui:FindFirstChild("GUI")
    if not gui then return nil end
    local n1 = gui:FindFirstChild("\228\186\140\231\186\167\231\149\140\233\157\162")
    if not n1 then return nil end
    local n2 = n1:FindFirstChild("\229\133\172\228\188\154")
    if not n2 then return nil end
    local n3 = n2:FindFirstChild("\232\131\140\230\153\175")
    if not n3 then return nil end
    local n4 = n3:FindFirstChild("\229\143\179\228\190\167\231\149\140\233\157\162")
    if not n4 then return nil end
    local n5 = n4:FindFirstChild("\229\149\134\229\186\151")
    if not n5 then return nil end
    local n6 = n5:FindFirstChild("\229\133\172\228\188\154\229\184\129")
    if not n6 then return nil end
    for _, child in pairs(n6:GetDescendants()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            local txt = tostring(child.Text or "")
            txt = txt:gsub(",", ""):gsub(" ", "")
            local num = tonumber(txt)
            if num then return num end
        end
    end
    return nil
end

-- =========================
-- File helpers
-- =========================

local function safeRead(filename)
    local ok, content = pcall(function() return readfile(filename) end)
    if ok and content then return content end
    return nil
end

local function safeWrite(filename, content)
    pcall(function() writefile(filename, content) end)
end

-- =========================
-- Date / Username
-- =========================

local function getToday()
    local ok, result = pcall(function() return os.date("%Y-%m-%d") end)
    if ok and result then return result end
    return tostring(os.time())
end

local function getUsername()
    return tostring(player.Name)
end

-- =========================
-- Herb count → number
-- =========================

local function parseHerb(raw)
    if not raw or raw == "N/A" then return nil end
    local s = tostring(raw):gsub(",", ""):gsub(" ", "")
    -- รองรับ K suffix เช่น 1862K
    local kVal = s:match("^(%d+%.?%d*)[Kk]$")
    if kVal then return math.floor(tonumber(kVal) * 1000) end
    return tonumber(s)
end

-- =========================
-- Write base.txt
-- =========================

local function writeBase()
    local herb = getHerbCount()
    local num = parseHerb(herb)
    local val = num and tostring(num) or tostring(herb)
    safeWrite("base.txt", val)
    print("📦 base.txt: " .. val)
end

-- =========================
-- daily.txt
-- =========================

local function isDailyDone()
    local content = safeRead("daily.txt")
    if not content then return false end
    local today = getToday()
    if content:find(today, 1, true) then
        print("✅ Daily already done today (" .. today .. ") — skip")
        return true
    end
    return false
end

local function writeDailyFile()
    local content = getUsername() .. "|" .. getToday()
    safeWrite("daily.txt", content)
    print("📅 daily.txt: " .. content)
end

-- =========================
-- login_trigger.txt
-- เช็คว่า bash อนุญาตให้ login หรือยัง
-- bash เขียน "on" ก่อน แล้ว Lua ถึงจะเริ่ม
-- =========================

local function isLoginTriggered()
    local content = safeRead("login_trigger.txt")
    if not content then return false end
    return content:lower():find("on") ~= nil
end

local function waitForLoginTrigger()
    print("⏳ Waiting for login_trigger.txt = on ...")
    while true do
        if isLoginTriggered() then
            print("✅ Login trigger received")
            return
        end
        task.wait(3)
    end
end

-- =========================
-- Guild shop — ซื้อสมุนไพร
-- =========================

local function autoBuyHerb()
    for _, obj in pairs(playerGui:GetDescendants()) do
        if obj.Name == "\229\136\151\232\161\168"
            and obj.Parent
            and obj.Parent.Name == "\229\149\134\229\186\151"
        then
            local index = 0
            local found = false
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Frame") then
                    index = index + 1
                    local nameLabel = child:FindFirstChild("\229\144\141\231\167\176", true)
                    if nameLabel and nameLabel.Text == "Herb" then
                        local coins = getGuildCoins()
                        if coins and coins >= 400 then
                            print("✅ Slot " .. index .. " = Herb | coins=" .. coins .. " → buy")
                            buyRemote:FireServer(index)
                            task.wait(0.2)
                            found = true
                        else
                            print("⛔ Not enough coins (" .. tostring(coins) .. ")")
                        end
                    end
                end
            end
            if not found then print("ℹ️ Herb not found in shop") end
            return
        end
    end
    print("❌ Shop list not found")
end

local function buyHerbWithRefresh()
    autoBuyHerb()
    task.wait(0.3)
    local coinsLeft = getGuildCoins()
    if coinsLeft and coinsLeft >= 400 then
        print("🔄 Refreshing shop")
        refreshRemote:FireServer()
        task.wait(1.5)
        autoBuyHerb()
    else
        print("ℹ️ Not enough coins to refresh")
    end
end

