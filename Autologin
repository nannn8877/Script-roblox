-- =========================
-- Daily Login
-- รันเมื่อ bash เปิด login_trigger
-- =========================

local function runDailyLogin()
    -- เช็ค daily.txt ก่อน (ไม่ต้องรอ trigger ถ้าทำไปแล้ว)
    if isDailyDone() then return end

    -- รอ bash อนุญาต (login_trigger.txt = on)
    waitForLoginTrigger()

    print("🔐 Daily Login starting...")

    local ok, err = pcall(function()
        -- 1. Herb collect
        local vec = Vector2.new(654.7196655273438, 178.2879180908203)
        for _, num in ipairs({1,2,3,4,5}) do
            herbRemote:FireServer(num, vec)
            task.wait(0.05)
        end

        -- 2. Mailbox
        mailboxRemote:FireServer()
        task.wait(0.1)

        -- 3. Remote1 (1-3)
        for i = 1, 3 do
            remote1:FireServer(i)
            task.wait(0.05)
        end

        -- 4. Remote2 (1-3)
        for i = 1, 3 do
            remote2:FireServer(i)
            task.wait(0.05)
        end

        -- 5. Remote3 (5x)
        for i = 1, 5 do
            remote3:FireServer()
            task.wait(0.05)
        end

        -- 6. RemoteA (1-5, 3x each)
        local vecA = Vector2.new(643.2603759765625, 306.132568359375)
        for num = 1, 5 do
            for _ = 1, 3 do
                remoteA:FireServer(num, vecA)
                task.wait(0.05)
            end
        end

        -- 7. Spin wheel
        spinWheel()

        -- 8. RemoteC (1-6)
        for i = 1, 6 do
            remoteC:FireServer(i)
            task.wait(0.05)
        end

        -- 9. RemoteD (1-15)
        for i = 1, 15 do
            remoteD:FireServer(i)
            task.wait(0.05)
        end

        -- 10. Buy herb from guild shop
        buyHerbWithRefresh()
    end)

    if not ok then
        print("❌ Daily Error: " .. tostring(err))
        -- เขียน daily.txt ต่อให้ bash รู้ว่า error แต่ผ่านแล้ว
        -- (bash จะ timeout และปิดแอพเองถ้าไม่อัปเดต)
        return
    end

    -- เขียน daily.txt → bash จะเห็นและปิดแอพ
    writeDailyFile()

    -- เขียน base.txt หลัง daily เสร็จ
    writeBase()

    print("✅ Daily Login Complete")
end

-- =========================
-- Elixir Producer
-- รันตลอด background อ่าน stats.txt
-- =========================

local function startElixirProducer()
    task.spawn(function()
        print("⚗️ Elixir Producer started")
        while true do
            local content = safeRead("stats.txt")

            if content and content:lower():find("on") then
                -- ยิง elixir remote
                local eok, eerr = pcall(function()
                    elixirRemote:FireServer()
                end)
                if not eok then
                    print("❌ Elixir Error: " .. tostring(eerr))
                end

                -- อัปเดต base.txt ทุกรอบ (bash อ่านเพื่อเช็ค herb)
                writeBase()
            else
                print("⏸️ Elixir paused (stats.txt != on)")
            end

            task.wait(1)
        end
    end)
end

