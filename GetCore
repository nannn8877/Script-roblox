repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Player = Players.LocalPlayer

local isTweening = false
local noclipEnabled = false
local noclipLoop

-- =========================
-- 🔹 ซ่อนชื่อ
-- =========================
local function hideName(char)
    local hum = char:WaitForChild("Humanoid")

    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
end

Player.CharacterAdded:Connect(function(char)
    hideName(char)
end)

if Player.Character then
    hideName(Player.Character)
end

-- =========================
-- 🔹 Noclip
-- =========================
local function setNoclip(state, char)
    noclipEnabled = state

    if noclipLoop then
        noclipLoop:Disconnect()
        noclipLoop = nil
    end

    if state then
        noclipLoop = RunService.Stepped:Connect(function()
            for _, v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end)
    else
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end
    end
end

-- =========================
-- 🔹 หา target
-- =========================
local function getTarget(name)
    local obj = workspace:FindFirstChild(name, true)
    if not obj then return nil end

    if obj:IsA("Model") then
        obj = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end

    return obj
end

-- =========================
-- 🔹 Tween ไปหา object
-- =========================
local function TPToTarget()
    if isTweening then return end

    local char = Player.Character or Player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")

    local target = getTarget("主要部件") -- เปลี่ยนชื่อ object ได้
    if not target then
        warn("หา object ไม่เจอ!")
        return
    end

    isTweening = true
    setNoclip(true, char)

    -- Body movers
    local bV = Instance.new("BodyVelocity")
    bV.MaxForce = Vector3.new(9e9,9e9,9e9)
    bV.Velocity = Vector3.new(0,0,0)
    bV.Parent = root

    local bG = Instance.new("BodyGyro")
    bG.MaxTorque = Vector3.new(9e9,9e9,9e9)
    bG.P = 9e4
    bG.CFrame = root.CFrame
    bG.Parent = root

    -- Tween
    local tween = TweenService:Create(root, TweenInfo.new(1), {
        CFrame = target.CFrame
    })

    tween:Play()

    tween.Completed:Connect(function()
        if noclipLoop then noclipLoop:Disconnect() end
        if bV then bV:Destroy() end
        if bG then bG:Destroy() end

        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = true
            end
        end

        isTweening = false
        print("TP สำเร็จ + ซ่อนชื่อแล้ว")
    end)
end

-- =========================
-- 🔹 เรียกใช้งาน
-- =========================
TPToTarget()
