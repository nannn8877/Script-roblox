repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer

local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local isTeleporting = false

-- =========================
-- 🔹 ซ่อนชื่อ
-- =========================
local function hideName(char)
    local hum = char:WaitForChild("Humanoid")

    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
end

Player.CharacterAdded:Connect(function(char)
    hideName(char)
end)

if Player.Character then
    hideName(Player.Character)
end

-- =========================
-- 🔹 หา target
-- =========================
local function getTarget(name)
    local obj = workspace:FindFirstChild(name, true)
    if not obj then return nil end

    if obj:IsA("Model") then
        obj = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end

    return obj
end

-- =========================
-- 🔹 วาปไป + กลับ
-- =========================
local function TPFlash()
local function TPFlash()
    if isTeleporting then return end

    local char = Player.Character or Player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")

    local target = getTarget("主要部件")
    if not target then
        warn("หา object ไม่เจอ!")
        return
    end

    isTeleporting = true

    local originalCFrame = root.CFrame

    -- 📌 ปรับตำแหน่ง (ลง -20)
    local offset = Vector3.new(0, -20, 0)
    local newCFrame = target.CFrame + offset

    -- ⚡ วาปไป
    root.CFrame = newCFrame

    task.wait(0.1)

    -- ⚡ วาปกลับ
    root.CFrame = originalCFrame

    isTeleporting = false
end

-- =========================
-- 🔹 เรียกใช้
-- =========================
TPFlash()
