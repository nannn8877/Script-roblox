repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local isMoving = false

-- =========================
-- 🔹 ซ่อนชื่อ
-- =========================
local function hideName(char)
    local hum = char:WaitForChild("Humanoid")
    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
end

Player.CharacterAdded:Connect(hideName)
if Player.Character then hideName(Player.Character) end

-- =========================
-- 🔹 target (ใช้ path ตรง)
-- =========================
local function getTarget()
    return workspace:WaitForChild("单位对象")
        :WaitForChild("水晶")
        :WaitForChild("HumanoidRootPart")
end

-- =========================
-- 🔹 Tween ไปหา object
-- =========================
local function TweenToTarget()
    if isMoving then return end

    local char = Player.Character or Player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")

    local target = getTarget()
    if not target then
        warn("❌ หา object ไม่เจอ!")
        return
    end

    isMoving = true

    -- 📌 ระยะห่าง
    local distance = (root.Position - target.Position).Magnitude

    -- 📌 ความเร็ว 200
    local speed = 200

    -- 📌 คำนวณเวลา
    local time = distance / speed

    -- 📌 Tween ไปหา (ขยับลงนิดนึง)
    local goal = {}
    goal.CFrame = target.CFrame * CFrame.new(0, -5, 0)

    local tween = TweenService:Create(
        root,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        goal
    )

    tween:Play()

    tween.Completed:Connect(function()
        isMoving = false
    end)
end

-- =========================
-- 🔹 GUI
-- =========================
local gui = Instance.new("ScreenGui")
gui.Name = "TweenUI"
gui.ResetOnSpawn = false
gui.Parent = Player:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Parent = gui
btn.Size = UDim2.new(0, 200, 0, 50)
btn.Position = UDim2.new(0.5, -100, 0.85, 0)
btn.Text = "Tween To Object"
btn.BackgroundColor3 = Color3.fromRGB(30,30,30)
btn.TextColor3 = Color3.fromRGB(255,255,255)
btn.TextSize = 16

local corner = Instance.new("UICorner", btn)
corner.CornerRadius = UDim.new(0, 10)

-- 🔹 กดปุ่ม = Tween
btn.MouseButton1Click:Connect(function()
    TweenToTarget()
end)

print("Tween GUI Loaded ✅")
