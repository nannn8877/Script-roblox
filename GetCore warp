repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer

local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local isTeleporting = false

-- =========================
-- 🔹 ซ่อนชื่อ
-- =========================
local function hideName(char)
    local hum = char:WaitForChild("Humanoid")
    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
end

Player.CharacterAdded:Connect(hideName)
if Player.Character then hideName(Player.Character) end

-- =========================
-- 🔹 หา target (ลึก + รองรับ Model)
-- =========================
local function getTarget(name)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == name then
            if obj:IsA("BasePart") then
                return obj
            elseif obj:IsA("Model") then
                return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            end
        end
    end
    return nil
end

-- =========================
-- 🔹 วาป
-- =========================
local function TPFlash()
    if isTeleporting then return end

    local char = Player.Character or Player.CharacterAdded:Wait()
    local root = char:FindFirstChild("HumanoidRootPart")

    if not root then
        warn("❌ ไม่เจอ HumanoidRootPart")
        return
    end

    local target = getTarget("主要部件") -- 🔁 ชื่อ object

    if not target then
        warn("❌ หา object ไม่เจอ!")
        return
    end

    isTeleporting = true

    local originalCFrame = root.CFrame

    -- 📌 ปรับ Y (ลงใต้)
    local offset = Vector3.new(0, -20, 0)
    local targetCFrame = target.CFrame + offset

    -- ⚡ วาปไป
    root.CFrame = targetCFrame

    -- ⏱ หน่วง (ปรับได้)
    task.wait(0.25)

    -- ⚡ วาปกลับ
    root.CFrame = originalCFrame

    isTeleporting = false
end

