local _ENV = (getgenv or getrenv or getfenv)()
local Module = {}

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- 🔹 จุดลอยฟ้า
local SAFE_ENVIRONMENT = _ENV.SAFE_ENVIRONMENT or Instance.new("Part")
SAFE_ENVIRONMENT.Parent = workspace
SAFE_ENVIRONMENT.Transparency = 0.5
SAFE_ENVIRONMENT.Size = Vector3.new(1000, 3, 1000)
SAFE_ENVIRONMENT.CFrame = CFrame.new(0, 50000, 0)
SAFE_ENVIRONMENT.Anchored = true

-- 🔹 วาป
function Module:Teleport(cf)
    HumanoidRootPart.CFrame = cf
end

-- 🔹 ดึง
function Module:Pull(part)
    if not part then return end
    
    local front = HumanoidRootPart.CFrame * CFrame.new(0, 0, -10)
    part.CFrame = front
end

-- 🔹 วาปขึ้นฟ้า
Module:Teleport(SAFE_ENVIRONMENT.CFrame + Vector3.new(0,10,0))

-- 🔥 target ตาม path ที่ให้มา
local target = workspace:WaitForChild("单位对象")
    :WaitForChild("水晶")
    :WaitForChild("HumanoidRootPart")

-- 🔥 ดึง
task.delay(1, function()
    Module:Pull(target)
end)
