-- รอเกมโหลดและ Player พร้อม
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

repeat task.wait() until Player and Player:FindFirstChild("PlayerGui")

-- 🔹 หา target (แก้ชื่อ object ของคุณ)
local function getTarget()
    local obj = workspace:WaitForChild("单位对象"):WaitForChild("水晶")
    if obj:IsA("Model") then
        return obj
    else
        return obj
    end
end

local target = getTarget()

-- 🔹 สร้าง GUI ใน PlayerGui
local gui = Instance.new("ScreenGui")
gui.Name = "FollowUI"
gui.ResetOnSpawn = false
gui.Parent = Player:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0,200,0,50)
btn.Position = UDim2.new(0.5,-100,0.9,0) -- ตรงกลางล่าง
btn.ZIndex = 10
btn.Text = "Follow: OFF"
btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
btn.TextColor3 = Color3.fromRGB(255,255,255)
btn.Parent = gui

local corner = Instance.new("UICorner", btn)
corner.CornerRadius = UDim.new(0,10)

-- 🔹 สถานะ
local following = false
local loop

-- 🔹 ฟังก์ชันเริ่มลอยตาม
local function startFollow()
    local char = Player.Character or Player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")

    loop = RunService.RenderStepped:Connect(function()
        if not target then return end

        local offset = CFrame.new(0, 5, 0) -- สูงจากหัว 5 studs
        if target:IsA("Model") then
            target:PivotTo(root.CFrame * offset)
        else
            target.CFrame = root.CFrame * offset
        end
    end)
end

-- 🔹 ฟังก์ชันหยุดลอย
local function stopFollow()
    if loop then
        loop:Disconnect()
        loop = nil
    end
end

-- 🔹 ปุ่มเปิด/ปิด
btn.MouseButton1Click:Connect(function()
    following = not following
    if following then
        btn.Text = "Follow: ON"
        startFollow()
    else
        btn.Text = "Follow: OFF"
        stopFollow()
    end
end)

-- 🔹 รองรับ respawn ตัวละคร
Player.CharacterAdded:Connect(function(char)
    if following then
        startFollow()
    end
end)

print("FollowUI Loaded Successfully!")
